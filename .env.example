# Скопіюйте у .env (він у .gitignore) і заповніть. Ключ — лише ваш, не комітьте його.

# Шлях 2B — ЕКСПЕРИМЕНТ, офіційно не підтримується: безкоштовна модель OpenRouter через Anthropic-сумісний endpoint.
WORKER_PROVIDER=openrouter
OPENROUTER_API_KEY=
# WORKER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Стелі одного запуску
# WORKER_MAX_TURNS=12
# WORKER_MAX_BUDGET_USD=0.20

# Варіант A (платний ключ Anthropic) теж підтримується кодом: WORKER_PROVIDER=anthropic і ANTHROPIC_API_KEY=
